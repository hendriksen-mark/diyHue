{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch diyHue",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/BridgeEmulator/HueEmulator3.py",
      "args": [
        "--docker",
        "--mac",
        "XX:XX:XX:XX:XX:XX",
        "--config_path",
        "${workspaceFolder}/config",
        "--debug",
        "--ip",
        "XXX.XXX.XXX.XXX"
      ],
      "console": "integratedTerminal",
      "sudo": true
    },
    {
      "name": "install own ui",
      "type": "node-terminal",
      "request": "launch",
      "command": "sh ${workspaceFolder}/install_ui.sh own"
    },
    {
      "name": "install diyhue ui",
      "type": "node-terminal",
      "request": "launch",
      "command": "sh ${workspaceFolder}/install_ui.sh diyhue"
    },
    {
      "name": "build docker",
      "type": "node-terminal",
      "request": "launch",
      "command": "sh ${workspaceFolder}/build_docker.sh"
    }
  ]
}
